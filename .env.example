# Required: Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: Supabase (persistent profiles, saved vocabulary, exam history)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Client-side equivalents (used when the above are absent)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Brevo (OTP signup emails; falls back to Brevo SMTP relay)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
